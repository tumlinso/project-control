{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-control.local/schemas/pcu-release-manifest-v1.json",
  "title": "PCU-V1 Project Control release manifest",
  "type": "object",
  "required": ["schema_version", "product_name", "package_version", "source_parent_commit", "source_tree_hash", "project_control_tool_schema_version", "observer_tool_names", "observer_schema_hashes", "codex_tool_names", "codex_schema_hashes", "todo_kernel_contract_hash", "profile_contract_hash", "migration_contract_hash", "installer_contract_hash", "test_evidence_digest", "supported_todo_schema_versions", "supported_project_front_doors", "compatibility_aliases", "created_at", "authority_to_install"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "product_name": {"type": "string", "const": "project-control"},
    "package_version": {"type": "string", "minLength": 1},
    "source_parent_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_tree_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "project_control_tool_schema_version": {"type": "integer", "minimum": 1},
    "observer_tool_names": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"type": "string"}},
    "observer_schema_hashes": {"type": "object", "minProperties": 15, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "codex_tool_names": {"type": "array", "minItems": 20, "maxItems": 20, "uniqueItems": true, "items": {"type": "string"}},
    "codex_schema_hashes": {"type": "object", "minProperties": 20, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "todo_kernel_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "installer_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "supported_todo_schema_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "supported_project_front_doors": {"type": "array", "contains": {"const": "project-control"}, "items": {"type": "string"}},
    "compatibility_aliases": {"type": "array", "items": {"type": "string"}},
    "created_at": {"type": "string", "format": "date-time"},
    "authority_to_install": {"const": false}
  },
  "additionalProperties": false
}
