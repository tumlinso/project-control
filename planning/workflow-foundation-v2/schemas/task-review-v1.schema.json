{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WF2 task review receipt (shape, not truth proof)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "task_id",
    "source_commit",
    "author",
    "reviewer",
    "status",
    "unresolved_required",
    "assertions"
  ],
  "properties": {
    "format": {
      "const": "wf2-task-review-v1"
    },
    "task_id": {
      "type": "string"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40,64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "pending"
      ]
    },
    "unresolved_required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "explanation",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "blocked"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "domain",
                "path",
                "sha256"
              ],
              "properties": {
                "domain": {
                  "enum": [
                    "source",
                    "evidence"
                  ]
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  }
}
