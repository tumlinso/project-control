{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-control:as1:search-query",
  "title": "AS1 search query",
  "description": "Discovery queries retain their existing behavior; exact typed entity references route directly to canonical lookup.",
  "oneOf": [
    {
      "type": "string"
    },
    {
      "type": "object",
      "required": [
        "kind",
        "target"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  ]
}
