{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AS1 packet",
  "type": "object",
  "required": [
    "format",
    "packet_id",
    "alias",
    "created_at",
    "tool",
    "payload",
    "payload_sha256",
    "sources",
    "parents",
    "access_scope"
  ],
  "properties": {
    "format": {
      "const": "pc-packet/1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 8
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z]+(?:-[a-z]+){1,3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tool": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    },
    "payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "project",
          "repository",
          "path",
          "content_sha256"
        ],
        "properties": {
          "project": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "worktree": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "parents": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "access_scope": {
      "type": "object"
    },
    "freshness": {
      "type": "object"
    },
    "omissions": {
      "type": "array"
    },
    "pinned_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
