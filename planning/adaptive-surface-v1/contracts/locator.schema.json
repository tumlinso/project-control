{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AS1 locator",
  "type": "object",
  "required": [
    "project",
    "repository",
    "path",
    "content_sha256"
  ],
  "properties": {
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revision": {
      "type": [
        "string",
        "null"
      ]
    },
    "line_start": {
      "type": "integer",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "minimum": 1
    },
    "worktree": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
