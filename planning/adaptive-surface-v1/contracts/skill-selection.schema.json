{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AS1 skill-selection",
  "type": "object",
  "required": [
    "format",
    "selections",
    "synthesis"
  ],
  "properties": {
    "format": {
      "const": "pc-skill-selection/1"
    },
    "synthesis": {
      "type": "string"
    },
    "selections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "skill",
          "resource",
          "content_sha256",
          "line_start",
          "line_end",
          "reason"
        ],
        "properties": {
          "skill": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
