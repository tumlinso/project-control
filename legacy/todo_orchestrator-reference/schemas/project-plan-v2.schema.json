{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/todo-orchestrator/project-plan-v2.schema.json",
  "title": "Todo Orchestrator Project Plan v2",
  "type": "object",
  "required": ["schema_version", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "project": {"type": "object", "properties": {"name": {"type": "string"}}, "additionalProperties": true},
    "invariants": {"type": "array", "items": {"$ref": "#/$defs/invariant"}},
    "decisions": {"type": "array", "items": {"$ref": "#/$defs/decision"}},
    "locks": {"type": "array", "items": {"$ref": "#/$defs/lock"}},
    "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}},
    "barriers": {"type": "array", "items": {"$ref": "#/$defs/barrier"}},
    "resource_classes": {"type": "array", "items": {"$ref": "#/$defs/resource_class"}},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
    "invariant": {
      "type": "object", "required": ["id", "rule"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "rule": {"type": "string"}, "scope": {"type": "object"}, "severity": {"enum": ["info", "warning", "error"]}, "enforcement": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "decision": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "value": {}, "allowed": {"type": "array"}},
      "additionalProperties": false
    },
    "lock": {
      "type": "object", "required": ["name"],
      "properties": {"name": {"$ref": "#/$defs/id"}, "capacity": {"type": "integer", "minimum": 1}, "metadata": {"type": "object"}},
      "additionalProperties": false
    },
    "interface": {
      "type": "object", "required": ["id", "owner_task_id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "owner_task_id": {"$ref": "#/$defs/id"}, "state": {"enum": ["draft", "frozen", "revised", "deprecated"]}, "version": {"type": ["string", "number"]}, "contract_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "content_hash": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "dependency": {
      "type": "object", "required": ["type"],
      "properties": {
        "type": {"enum": ["task", "checkpoint", "interface", "barrier", "decision"]},
        "task_id": {"type": "string"}, "checkpoint_id": {"type": "string"}, "interface_id": {"type": "string"}, "barrier_id": {"type": "string"}, "decision_id": {"type": "string"},
        "operator": {"enum": ["equals", "in"]}, "value": {}, "state": {"type": "string"}, "version": {"type": ["string", "number"]}, "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}}
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "properties": {
        "exclusive_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "read_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "forbidden_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "shared_locks": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      },
      "additionalProperties": false
    },
    "checkpoint": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "state": {"enum": ["pending", "reached", "revoked"]}, "metadata": {"type": "object"}, "publishes_interfaces": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "version": {"type": ["string", "number"]}}, "additionalProperties": false}}},
      "additionalProperties": false
    },
    "gate": {
      "type": "object", "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "type": {"enum": ["command", "benchmark", "json_predicate", "file_exists", "pattern", "task_state", "checkpoint", "interface", "manual"]}, "required": {"type": "boolean"}, "checkpoint_id": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "cwd": {"$ref": "#/$defs/path"}, "env": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}, "timeout": {"type": "number", "exclusiveMinimum": 0}, "expected_exit_code": {"type": "integer"},
        "resources": {"type": "array", "items": {"type": "string"}}, "locks": {"type": "array", "items": {"type": "string"}}, "input_paths": {"type": "array", "items": {"$ref": "#/$defs/path"}}, "interfaces": {"type": "array", "items": {"type": "string"}}, "track_git_head": {"type": "boolean"},
        "path": {"$ref": "#/$defs/path"}, "pattern": {"type": "string"}, "task_id": {"type": "string"}, "status": {"type": "string"}, "result": {"type": "string"}, "interface_id": {"type": "string"}, "state": {"type": "string"}, "version": {"type": ["string", "number"]}, "accepted": {"type": "boolean"}, "note": {"type": "string"},
        "metric_file": {"$ref": "#/$defs/path"}, "metric_path": {"type": "string"}, "operator": {"enum": [">=", ">", "<=", "<", "=="]}, "threshold": {"type": "number"}, "evaluation_required": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "resource_request": {
      "type": "object", "required": ["selector"],
      "properties": {"id": {"type": "string"}, "phase": {"enum": ["claim", "checkpoint", "gate", "manual"]}, "selector": {"type": "string"}, "amount": {"type": "integer", "minimum": 1}, "mode": {"enum": ["exclusive", "shared"]}, "required": {"type": "boolean"}},
      "additionalProperties": false
    },
    "disposition": {"enum": ["implemented", "validated", "evaluated_not_promoted", "no_change_required", "superseded", "failed"]},
    "task": {
      "type": "object", "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "parent_id": {"type": ["string", "null"]}, "kind": {"enum": ["epic", "workstream", "task", "integration", "integration_task", "validation", "validation_task"]}, "title": {"type": "string"}, "objective": {"type": "string"},
        "status": {"enum": ["planned", "in_progress", "blocked", "review", "done", "superseded", "cancelled", "stale", "attention_required"]}, "priority": {"type": "integer"}, "tags": {"type": "array", "items": {"type": "string"}}, "parallel_policy": {"enum": ["parallel_safe", "serial", "project_exclusive", "integration_exclusive"]},
        "result": {"$ref": "#/$defs/disposition"}, "next_action": {"type": "string"}, "notes": {"type": "string"}, "depends_on": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "scope": {"$ref": "#/$defs/scope"},
        "claim_locks": {"type": "array", "items": {"type": "string"}}, "invariants": {"type": "array", "items": {"type": "string"}}, "consumes_interfaces": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}, "required_state": {"type": "string"}, "required_version": {"type": ["string", "number", "null"]}}, "additionalProperties": false}},
        "checkpoints": {"type": "array", "items": {"$ref": "#/$defs/checkpoint"}}, "gates": {"type": "array", "items": {"$ref": "#/$defs/gate"}}, "resource_requests": {"type": "array", "items": {"$ref": "#/$defs/resource_request"}},
        "produced_artifacts": {"type": "array", "items": {"type": "object", "required": ["path"], "properties": {"kind": {"type": "string"}, "path": {"$ref": "#/$defs/path"}}, "additionalProperties": false}},
        "result_policy": {"type": "object", "properties": {"allowed_dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}}}, "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "barrier_requirement": {
      "type": "object", "required": ["type", "id"],
      "properties": {"type": {"enum": ["task", "validation_task", "checkpoint", "interface", "gate"]}, "id": {"type": "string"}, "state": {"type": "string"}, "dispositions": {"type": "array", "items": {"$ref": "#/$defs/disposition"}}},
      "additionalProperties": false
    },
    "barrier": {
      "type": "object", "required": ["id", "requirements"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "title": {"type": "string"}, "mode": {"enum": ["all", "quorum"]}, "quorum": {"type": "integer", "minimum": 1}, "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/barrier_requirement"}}},
      "additionalProperties": false
    },
    "resource_instance": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"type": "string"}, "capacity": {"type": "integer", "minimum": 1}, "hostname": {"type": ["string", "null"]}, "metadata": {"type": "object"}},
      "additionalProperties": false
    },
    "resource_class": {
      "type": "object", "required": ["id"],
      "properties": {"id": {"type": "string"}, "mode": {"enum": ["exclusive", "shared"]}, "metadata": {"type": "object"}, "instances": {"type": "array", "items": {"$ref": "#/$defs/resource_instance"}}},
      "additionalProperties": false
    }
  }
}
