{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/core4/artifact-ref-v1.schema.json",
  "title": "CORE4 artifact reference v1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "path",
    "complete"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "complete": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
