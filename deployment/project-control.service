[Unit]
Description=Project Control architectural observatory
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project-control
ExecStart=%h/.local/bin/uv run --frozen project-control serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/project-control %h/.config/project-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
