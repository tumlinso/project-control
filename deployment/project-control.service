[Unit]
Description=Project Control architectural observatory
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project-control
Environment=PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR=%h/.cache/project-control/observer-analysis
Environment=PROJECT_CONTROL_PERFORMANCE_PROBE_STATE_DIR=%h/.cache/project-control/performance-probe
Environment=TODO_BACKGROUND_HOST_RUNTIME_DIR=%t/codex-todo-orchestrator
ExecStart=%h/.local/bin/uv run --frozen project-control serve
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=codex-todo-orchestrator
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/project-control %h/.config/project-control
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
