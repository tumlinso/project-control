[Unit]
Description=OpenAI Secure MCP Tunnel client for project-control
After=project-control.service
Requires=project-control.service

[Service]
Type=simple
# Install the official OpenAI tunnel client and replace this executable name if
# its installed path differs. Credentials stay in the owner-only environment
# file created during OpenAI account setup; never put them in this repository.
EnvironmentFile=%h/.config/project-control/tunnel.env
ExecStart=%h/.local/bin/openai-mcp-tunnel --config %h/.config/project-control/tunnel-client.yaml
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/project-control %h/.config/project-control

[Install]
WantedBy=default.target
