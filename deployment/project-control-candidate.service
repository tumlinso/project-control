[Unit]
Description=Project Control candidate verification service
After=network.target

[Service]
Type=simple
Environment=PROJECT_CONTROL_PROFILE=observer
Environment=PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR=%h/.cache/project-control/observer-analysis
Environment=TODO_BACKGROUND_HOST_RUNTIME_DIR=%t/codex-todo-orchestrator
ExecStart=@CANDIDATE_ROOT@/bin/project-control observer --host 127.0.0.1 --port @CANDIDATE_PORT@
RuntimeDirectory=codex-todo-orchestrator
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/project-control/observer-analysis
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
