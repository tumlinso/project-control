{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "shared-engine-cutover-v1",
  "type": "object", "additionalProperties": false,
  "required": ["format", "owner_task", "ctxpp_query", "source_identity", "facades", "mapping", "fencing", "closure_order"],
  "properties": {
    "format": {"const": "shared-engine-cutover-v1"},
    "owner_task": {"const": "PC-WF2-C03"},
    "ctxpp_query": {"type": "object", "additionalProperties": false, "required": ["read_only", "no_refresh", "standalone"], "properties": {"read_only": {"const": true}, "no_refresh": {"const": true}, "standalone": {"const": true}}},
    "source_identity": {"type": "object", "additionalProperties": false, "required": ["algorithm", "version", "domain", "covered_inputs"], "properties": {"algorithm": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "domain": {"type": "string", "minLength": 1}, "covered_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}}}},
    "facades": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["name", "supported", "write_authority"], "properties": {"name": {"enum": ["host", "worker"]}, "supported": {"const": true}, "write_authority": {"const": false}}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["donor", "recipient", "parity_before_semantics"], "properties": {"donor": {"const": "todo_orchestrator"}, "recipient": {"const": "project_control.workflow_core"}, "parity_before_semantics": {"const": true}}},
    "fencing": {"type": "object", "additionalProperties": false, "required": ["old_writers", "rollback"], "properties": {"old_writers": {"const": "quiesce_before_affected_cutover"}, "rollback": {"const": "restore_or_migrate_forward_unless_qualified"}}},
    "closure_order": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
