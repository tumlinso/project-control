{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "workflow-snapshot-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "workflow_revision", "observed_at", "tasks", "warnings"],
  "properties": {
    "format": {"const": "workflow-snapshot-v1"},
    "workflow_revision": {"type": "integer", "minimum": 0},
    "observed_at": {"type": "string", "format": "date-time"},
    "tasks": {"type": "array", "items": {"$ref": "workflow-task-record-v1.schema.json"}},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}
  }
}
