{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation-reference-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "reference", "workspace", "permission_domain", "workflow_revision", "source_identity", "fields", "expires_at", "warnings"],
  "properties": {
    "format": {"const": "observation-reference-v1"},
    "reference": {"type": "string", "minLength": 1},
    "workspace": {"type": "string", "minLength": 1},
    "permission_domain": {"type": "string", "minLength": 1},
    "workflow_revision": {"type": "integer", "minimum": 0},
    "source_identity": {"type": "string", "minLength": 1},
    "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "expires_at": {"type": "string", "format": "date-time"},
    "warnings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}}}
  }
}
