#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
venv_path="$repo_root/.venv"
python="$venv_path/bin/python"

usage() {
  cat >&2 <<'EOF'
usage:
  scripts/pc-dev setup --foundation-repo PATH [--todo-wheel PATH]
  scripts/pc-dev run <project-control arguments...>
  scripts/pc-dev test [pytest selectors and options...]
  scripts/pc-dev python <Python arguments...>  # internal source passthrough

Examples:
  scripts/pc-dev setup --foundation-repo ../project-foundations
  scripts/pc-dev run serve observer --host 127.0.0.1 --port 8768
  scripts/pc-dev run serve mutator
  scripts/pc-dev test tests/test_workflow_binding.py -q
EOF
}

action="${1:-}"
if [[ -z "$action" ]]; then
  usage
  exit 2
fi
shift

check_venv_target() {
  if [[ -L "$venv_path" ]]; then
    local resolved
    resolved="$(readlink -f "$venv_path" 2>/dev/null || true)"
    case "$resolved" in
      "$repo_root"/*) ;;
      *)
        echo "refusing to use .venv symlink outside this checkout: $venv_path -> ${resolved:-unresolved}" >&2
        exit 2
        ;;
    esac
  fi
}

source_environment() {
  local mode="${1:-run}"
  unset PYTHONHOME PYTHONPATH
  unset PROJECT_CONTROL_RELEASE_MANIFEST PROJECT_CONTROL_RELEASE_DIGEST
  unset PROJECT_CONTROL_TODO_RUNTIME_FINGERPRINT CODING_WORKFLOW_RUNTIME_FINGERPRINT
  unset PROJECT_CONTROL_RUNTIME_PYTHON CODING_WORKFLOW_RUNTIME_PYTHON
  unset CODING_WORKFLOW_SKILLS_ROOT PROJECT_CONTROL_TEST_SKILLS_ROOT
  unset PROJECT_CONTROL_OBSERVER_SUPERVISOR_SHA256
  unset PROJECT_CONTROL_LOCAL_RUNTIME_ROOT PROJECT_CONTROL_LOCAL_RUNTIME_MANIFEST_SHA256
  if [[ "$mode" == test || "$mode" == test_helpers ]]; then
    unset PROJECT_CONTROL_SKILLS_ROOT
    unset TODO_ORCHESTRATOR_STATE_DIR PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR
  elif [[ ! ${PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR+x} ]]; then
    export PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR="${HOME}/.cache/project-control/as1-observer-analysis"
  fi
  if [[ "$mode" == test ]]; then
    export PYTHONPATH="$repo_root/src:$repo_root"
  elif [[ "$mode" == test_helpers ]]; then
    export PYTHONPATH="$repo_root/src:$repo_root/tests/todo"
  else
    export PYTHONPATH="$repo_root/src"
  fi
  export PYTHONNOUSERSITE=1
  export PYTHONDONTWRITEBYTECODE=1
  export PROJECT_CONTROL_AS1_STATE_DIR="$repo_root/.state/as1"
  export PROJECT_CONTROL_SOURCE_STATE_DIR="$repo_root/.cache/source"
}

case "$action" in
  setup)
    todo_wheel="${PROJECT_CONTROL_TODO_WHEEL:-}"
    foundation_repo="${PROJECT_FOUNDATIONS_REPO:-}"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --todo-wheel) [[ $# -ge 2 ]] || { echo "--todo-wheel needs a path" >&2; exit 2; }; todo_wheel="$2"; shift 2 ;;
        --foundation-repo) [[ $# -ge 2 ]] || { echo "--foundation-repo needs a path" >&2; exit 2; }; foundation_repo="$2"; shift 2 ;;
        *) echo "unknown setup argument: $1" >&2; exit 2 ;;
      esac
    done
    if [[ -z "$foundation_repo" || ! -d "$foundation_repo/packages/project-source" || ! -d "$foundation_repo/packages/project-evidence" ]]; then
      echo "Project Foundations checkout required; pass --foundation-repo PATH" >&2
      exit 2
    fi
    foundation_repo="$(cd "$foundation_repo" && pwd -P)"
    if [[ -n "$todo_wheel" ]]; then
      if [[ -L "$todo_wheel" ]]; then echo "standalone Todo wheel path must not be a symlink" >&2; exit 2; fi
      todo_wheel="$(readlink -f "$todo_wheel" 2>/dev/null || true)"
      if [[ -z "$todo_wheel" || ! -f "$todo_wheel" ]]; then echo "standalone Todo wheel is missing or unreadable: ${todo_wheel:-unset}" >&2; exit 2; fi
    fi
    if ! command -v uv >/dev/null 2>&1; then
      echo "uv is unavailable; install uv, then run scripts/pc-dev setup" >&2
      exit 2
    fi
    check_venv_target
    cd "$repo_root"
    cache_dir="${UV_CACHE_DIR:-$repo_root/.cache/uv}"
    mkdir -p "$cache_dir"
    export UV_CACHE_DIR="$cache_dir"
    export UV_PROJECT_ENVIRONMENT="$venv_path"
    wheel_dir="$cache_dir/project-foundation-wheels"
    mkdir -p "$wheel_dir"
    uv build --wheel --out-dir "$wheel_dir" "$foundation_repo/packages/project-source"
    uv build --wheel --out-dir "$wheel_dir" "$foundation_repo/packages/project-evidence"
    # Foundations are built from the caller-selected peer checkout. uv records
    # flat-index wheel paths in its lockfile, so resolve the development
    # environment in a private scratch project instead of writing machine-local
    # wheelhouse paths into this repository's lock state.
    setup_project="$repo_root/.cache/pc-dev-environment"
    mkdir -p "$setup_project"
    cp "$repo_root/pyproject.toml" "$setup_project/pyproject.toml"
    cp "$repo_root/README.md" "$setup_project/README.md"
    uv sync --project "$setup_project" --no-install-project --group dev --find-links "$wheel_dir"
    if [[ -n "$todo_wheel" ]]; then
      "$python" "$repo_root/scripts/verify_todo_runtime.py" --wheel "$todo_wheel"
      uv pip install --python "$python" --no-deps --force-reinstall "$todo_wheel"
      "$python" "$repo_root/scripts/verify_todo_runtime.py" --installed
    fi
    ;;
  run)
    check_venv_target
    if [[ ! -x "$python" ]]; then
      echo "Project Control development environment is missing at $venv_path; run scripts/pc-dev setup" >&2
      exit 2
    fi
    source_environment
    if [[ ! -f "$repo_root/src/project_control/cli.py" ]]; then
      echo "Project Control source tree is incomplete under $repo_root/src" >&2
      exit 2
    fi
    needs_todo=0
    for argument in "$@"; do case "$argument" in codex|mutator|plan|todo-*) needs_todo=1 ;; esac; done
    if (( needs_todo )) && ! "$python" "$repo_root/scripts/verify_todo_runtime.py" --installed >/dev/null 2>&1; then
      echo "this operation needs the standalone Todo runtime; run scripts/pc-dev setup --foundation-repo PATH --todo-wheel PATH" >&2; exit 2
    fi
    exec "$python" -m project_control.cli "$@"
    ;;
  test)
    check_venv_target
    if [[ ! -x "$python" ]]; then
      echo "Project Control development environment is missing at $venv_path; run scripts/pc-dev setup" >&2
      exit 2
    fi
    source_environment test
    cd "$repo_root"
    if ! "$python" -c 'import pytest' >/dev/null 2>&1; then
      echo "pytest is missing from $venv_path; run scripts/pc-dev setup" >&2
      exit 2
    fi
    if [[ ! -f "$repo_root/src/project_control/cli.py" ]]; then
      echo "Project Control source tree is incomplete under $repo_root/src" >&2
      exit 2
    fi
    # Flags alone still mean "run the quick source smoke selection". Treat
    # values belonging to pytest options (notably -k/-m/-o/-c) as options,
    # while leaving any explicit file, directory, or node id selector intact.
    has_selector=0
    consume_next=0
    for argument in "$@"; do
      if (( consume_next )); then
        consume_next=0
        continue
      fi
      case "$argument" in
        --)
          has_selector=1
          break
          ;;
        -k|-m|-o|--override-ini|-c|-p|-W|--pythonwarnings|--confcutdir|--rootdir|--ignore|--ignore-glob|--deselect|--basetemp|--import-mode|--maxfail|--durations|--durations-min|--tb|--capture|--color|--junitxml|--junit-prefix|--log-level|--log-format|--log-date-format|--log-file|--log-file-level|--log-file-format|--log-file-date-format|--show-capture|--verbosity|--assert|--pastebin)
          consume_next=1
          ;;
        -*) ;;
        *) has_selector=1 ;;
      esac
    done
    if (( ! has_selector )); then
      set -- "$@" \
        tests/test_overhaul_acceptance.py \
        tests/test_project_resolution.py \
        tests/test_source_retrieval.py \
        tests/test_profiles.py \
        tests/test_machine_inspection.py
    fi
    exec "$python" -m pytest "$@"
    ;;
  python)
    check_venv_target
    if [[ ! -x "$python" ]]; then
      echo "Project Control development environment is missing at $venv_path; run scripts/pc-dev setup" >&2
      exit 2
    fi
    if [[ "${1:-}" == "--with-test-helpers" ]]; then
      shift
      source_environment test_helpers
      cd "$repo_root"
    else
      source_environment
    fi
    exec "$python" "$@"
    ;;
  *)
    echo "unknown pc-dev command: $action" >&2
    usage
    exit 2
    ;;
esac
