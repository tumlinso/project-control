[Unit]
Description=Project Control source HTTP observer
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/project-control
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=PROJECT_CONTROL_OBSERVER_ANALYSIS_STATE_DIR=%h/.cache/project-control/as1-observer-analysis
Environment=TODO_BACKGROUND_HOST_RUNTIME_DIR=/tmp/codex-todo-orchestrator-1000
Environment='PROJECT_CONTROL_OBSERVER_GPU_UUIDS=["GPU-21131915-1488-23af-38dd-1743ae1f5cc8","GPU-cf22c41f-5b58-77b1-3535-8fadd1ca6505","GPU-d745da9c-7649-8334-41f1-483afa6f3206","GPU-6c1cac7f-a360-0aef-ba98-2828bfd1db1a"]'
ExecStart=%h/project-control/scripts/pc-dev run serve observer --host 127.0.0.1 --port 8768
Restart=on-failure
RestartSec=2
UMask=0077
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=%h/.cache/project-control %h/.local/state/project-control %h/.config/project-control -/tmp/codex-todo-orchestrator-1000
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=default.target
Alias=project-control-as1.service
