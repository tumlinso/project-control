{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-coding-worker.local/schemas/delegation-spec-v1.schema.json",
  "title": "local coding worker delegation specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "backend", "role", "readonly", "repo_root", "child_token", "objective", "scopes", "target", "intent", "budget_tokens", "max_items"],
  "properties": {
    "format": {"const": "LCW-REQUEST/1"},
    "schema_version": {"const": 1},
    "backend": {"const": "fake"},
    "role": {"enum": ["explain", "debug", "review", "test_plan"]},
    "readonly": {"const": true},
    "repo_root": {"type": "string", "minLength": 1},
    "child_token": {"type": "string", "pattern": "^toch_", "minLength": 6},
    "objective": {"type": "string", "minLength": 1, "maxLength": 500},
    "scopes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "target": {"type": "string", "minLength": 1, "maxLength": 300},
    "intent": {"enum": ["understand", "debug", "test", "api", "performance"]},
    "budget_tokens": {"type": "integer", "minimum": 256, "maximum": 12000},
    "max_items": {"type": "integer", "minimum": 1, "maximum": 32}
  }
}
