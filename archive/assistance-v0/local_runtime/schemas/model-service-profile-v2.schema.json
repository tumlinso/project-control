{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/core4/model-service-profile-v2.schema.json",
  "title": "CORE4 model service profile v2",
  "type": "object",
  "required": ["format", "model_sha256", "allocated_gpu_uuids", "context_size", "split_mode", "port"],
  "properties": {
    "format": {"const": "CORE4-MODEL-SERVICE/2"},
    "model_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "allocated_gpu_uuids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "context_size": {"type": "integer", "minimum": 1},
    "gpu_layers": {"type": ["integer", "null"]},
    "split_mode": {"type": "string"},
    "tensor_split": {"type": ["array", "null"], "items": {"type": "number"}},
    "main_gpu": {"type": ["integer", "null"]},
    "kv_cache_type_k": {"type": ["string", "null"]},
    "kv_cache_type_v": {"type": ["string", "null"]},
    "numa_policy": {"type": ["string", "null"]},
    "cpu_threads": {"type": ["integer", "null"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "startup_timeout_seconds": {"type": "number", "minimum": 0},
    "idle_ttl_seconds": {"type": "number", "minimum": 0},
    "log_path": {"type": "string"}
  },
  "additionalProperties": false
}
